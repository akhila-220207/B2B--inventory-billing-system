# Backend Environment Variables Template
# Copy this file to .env and fill in the values

# Database Connection
# If you experience "querySrv ECONNREFUSED", use the direct shard format below:
# MONGODB_URI=mongodb://user:password@shard-00-00.mongodb.net:27017,shard-00-01.mongodb.net:27017,shard-00-02.mongodb.net:27017/dbname?ssl=true&authSource=admin&retryWrites=true&w=majority
MONGODB_URI=YOUR_MONGODB_URI_HERE

# JWT Secret
JWT_SECRET=your_jwt_secret_here

# Port
PORT=5000

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id_here
